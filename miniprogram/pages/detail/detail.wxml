<view class="page" wx:if="{{product}}">
  <image class="banner" src="{{coverUrl}}" mode="aspectFill" />
  <view class="card main">
    <view class="name">{{product.name}}</view>
    <view class="muted">{{product.desc}}</view>
    <view class="price">¥{{unitPrice}}</view>
  </view>

  <view class="card" wx:if="{{isRetail}}">
    <view class="muted">成品现取，不参与预定。</view>
  </view>

  <view class="card promo-card" wx:elif="{{promoHint || loyaltyHint}}">
    <view class="promo-title">优惠说明</view>
    <view class="promo-line" wx:if="{{loyaltyHint}}">{{loyaltyHint}}</view>
    <view class="muted" wx:if="{{promoHint}}">{{promoHint}}</view>
    <view class="muted">现切现做，取餐前约 40 分钟。</view>
  </view>

  <view class="card">
    <view class="section-title">规格</view>
    <view class="chips">
      <view
        class="chip {{specId === item.id ? 'on' : ''}}"
        wx:for="{{product.specs}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSpec"
      >{{item.name}} ¥{{item.price}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{extraPick > 0}}">
    <view class="section-title">自选水果（必选 {{extraPick}} 种）</view>
    <view class="muted" style="margin-bottom:16rpx">已选 {{extras.length}}/{{extraPick}}</view>
    <view class="chips">
      <view
        class="chip {{extraMap[item.id] ? 'on' : ''}}"
        wx:for="{{product.extras}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onExtra"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card" wx:elif="{{product.extras && product.extras.length}}">
    <view class="section-title">加料（可多选）</view>
    <view class="chips">
      <view
        class="chip {{extraMap[item.id] ? 'on' : ''}}"
        wx:for="{{product.extras}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onExtra"
      >{{item.name}} +¥{{item.price}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{isFruitBowl && toppings.length}}">
    <view class="section-title">小料（可多选，默认不加）</view>
    <view class="chips">
      <view
        class="chip {{toppingMap[item.id] ? 'on' : ''}}"
        wx:for="{{toppings}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTopping"
      >{{item.name}} +¥{{item.price}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">数量</view>
    <view class="qty">
      <view class="qbtn" bindtap="dec">-</view>
      <text>{{quantity}}</text>
      <view class="qbtn" bindtap="inc">+</view>
    </view>
  </view>

  <view class="footer dual">
    <view class="total">
      <view class="muted" style="font-size:22rpx">单价</view>
      <view class="price">¥{{unitPrice}}</view>
    </view>
    <view class="btn-ghost" bindtap="addCart">加入购物车</view>
    <view class="btn-primary pay" bindtap="buyNow">立即购买</view>
  </view>
</view>
