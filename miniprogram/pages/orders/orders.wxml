<view class="page">
  <view class="card item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="top">
      <text class="name">{{item.productName}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="muted">{{item.specName}} ×{{item.quantity}}<text wx:if="{{item.fulfillmentType === 'reserve'}}"> · {{item.pickupAtText}}</text><text wx:if="{{item.deliveryPointName}}"> · {{item.deliveryPointName}}</text></view>
    <view class="queue-tip" wx:if="{{item.queueTip}}">{{item.queueTip}}</view>
    <view class="bottom">
      <text class="code" wx:if="{{item.pickupCode}}">取餐码 {{item.pickupCode}}</text>
      <text class="price">¥{{item.amount}}</text>
    </view>
  </view>
  <view wx:if="{{!list.length}}" class="empty muted">还没有订单，去点一份吧</view>
</view>
