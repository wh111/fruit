<view class="page">
  <view class="card tip-card">
    <view class="tip-title">自定义金额付款</view>
    <view class="tip-desc">输入应付金额，可用会员余额或在线支付。可用于散装称重、临时加购等场景。</view>
  </view>

  <view class="card">
    <view class="label">应付金额（元）</view>
    <view class="amount-row">
      <text class="yen">¥</text>
      <input
        class="amount-input"
        type="digit"
        maxlength="7"
        placeholder="0.00"
        value="{{amountText}}"
        focus="{{true}}"
        bindinput="onAmount"
      />
    </view>
    <view class="hint">最少 0.01 元，最多 999.99 元</view>
  </view>

  <view class="card" wx:if="{{walletEnabled}}">
    <view class="label">支付方式</view>
    <view class="muted" style="margin-bottom:16rpx">余额 ¥{{balance}} · 默认会员支付，不可与微信混付</view>
    <view class="modes">
      <view
        class="mode {{payChannel === 'balance' ? 'on' : ''}}"
        data-channel="balance"
        bindtap="onPayChannel"
      >
        <view class="mode-name">会员支付</view>
        <view class="mode-desc">{{balanceEnough ? '整单扣余额' : (canPay ? '请充值' : '输入金额后扣余额')}}</view>
      </view>
      <view
        class="mode {{payChannel === 'wechat' ? 'on' : ''}}"
        data-channel="wechat"
        bindtap="onPayChannel"
      >
        <view class="mode-name">微信支付</view>
        <view class="mode-desc">整单微信付款</view>
      </view>
    </view>
    <view class="recharge-link" wx:if="{{canPay && !balanceEnough}}" bindtap="goRecharge">请充值 ›</view>
  </view>

  <view class="card">
    <view class="label">备注（选填）</view>
    <input
      class="remark"
      placeholder="如：葡萄、加购"
      maxlength="40"
      value="{{remark}}"
      bindinput="onRemark"
    />
  </view>

  <view class="pay-bar">
    <view class="pay-sum">
      <text class="muted">合计</text>
      <text class="sum">¥{{displayAmount}}</text>
    </view>
    <button
      wx:if="{{hasPhone}}"
      class="btn-primary pay"
      loading="{{paying}}"
      disabled="{{paying || !canPay}}"
      bindtap="submit"
    >{{payChannel === 'balance' ? (balanceEnough || !canPay ? '会员支付' : '请充值') : '微信支付'}}</button>
    <button
      wx:else
      class="btn-primary pay phone-pay"
      open-type="getPhoneNumber"
      bindgetphonenumber="onPhoneThenPay"
      loading="{{paying}}"
      disabled="{{paying || !canPay}}"
    >手机号快捷登录并支付</button>
  </view>
</view>
