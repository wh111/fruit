PORT=3000
# 正式环境务必改成随机长字符串
JWT_SECRET=请改成随机长密码
ADMIN_USER=admin
ADMIN_PASS=请改成强密码

# —— 数据存储 ——
# json=本地文件（仅开发）| mysql=腾讯云/阿里云 MySQL（正式）
DB_DRIVER=mysql
MYSQL_HOST=你的数据库内网地址
MYSQL_PORT=3306
MYSQL_USER=sijiguoxian
MYSQL_PASSWORD=数据库密码
MYSQL_DATABASE=sijiguoxian

# —— 微信支付（正式必填）——
PAY_MODE=wechat
WX_APPID=
WX_SECRET=
WX_MCH_ID=
WX_API_KEY=
WX_NOTIFY_URL=https://你的域名/api/pay/notify

# —— 云打印（正式建议开启）——
CLOUD_PRINT_ENABLED=true
CLOUD_PRINT_PROVIDER=feie
CLOUD_PRINT_USER=
CLOUD_PRINT_UKEY=
CLOUD_PRINT_SN=

# 视频公网前缀（正式环境填 https://api.域名.com，本地可留空）
# PUBLIC_BASE_URL=https://api.你的域名.com


# 若用易联云：
# CLOUD_PRINT_PROVIDER=yilianyun
# YLY_CLIENT_ID=
# YLY_CLIENT_SECRET=
# YLY_MACHINE_CODE=
