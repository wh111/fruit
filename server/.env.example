PORT=3000
# 正式环境务必改成随机长字符串
JWT_SECRET=请改成随机长密码
ADMIN_USER=admin
ADMIN_PASS=请改成强密码

# —— 数据存储 ——
# json=本地文件（仅开发）| mysql=腾讯云/阿里云 MySQL（正式）
DB_DRIVER=mysql
MYSQL_HOST=你的数据库内网地址
MYSQL_PORT=3306
MYSQL_USER=sijiguoxian
MYSQL_PASSWORD=数据库密码
MYSQL_DATABASE=sijiguoxian

# —— 微信支付（正式：企业商户直连）——
# 开发：PAY_MODE=mock（流程与正式相同：预支付→收银台→confirm）
# 上线：PAY_MODE=wechat，填企业商户号（主体类型选「企业」，非个体户）
# 主体：四季果先（北京）水果零售有限公司
PAY_MODE=mock
WX_APPID=wx7f915cfcf3f86b92
WX_SECRET=
WX_MCH_ID=
WX_API_KEY=
WX_NOTIFY_URL=https://sijixiansheng.xin/api/pay/notify
# 一般不用服务商。仅通道进件时才填：
# WX_SUB_MCH_ID=
# WX_SP_APPID=

# —— 订阅消息：订单就绪/投柜提醒（一次性）——
# 公众平台 → 功能 → 订阅消息 → 选用餐饮取餐类模板，把模板 ID 填下面
# KEYS 的字段名必须与模板一致（thing/character_string 等）
# WX_SUBSCRIBE_READY_TMPL_ID=
# WX_SUBSCRIBE_READY_KEYS={"product":"thing1","place":"thing2","code":"character_string3","tip":"thing4"}
# 开发版可填 developer；体验版 trial；正式 formal
# WX_SUBSCRIBE_STATE=formal

# —— 云打印（正式建议开启；德佟本机标签可先顶上）——
CLOUD_PRINT_ENABLED=false
CLOUD_PRINT_PROVIDER=feie
CLOUD_PRINT_USER=
CLOUD_PRINT_UKEY=
CLOUD_PRINT_SN=

# 视频/静态资源公网前缀（正式环境）
PUBLIC_BASE_URL=https://sijixiansheng.xin

# 开业日（北京时间 YYYY-MM-DD）：满3个月后预定券面额自动从3改为1.8
SHOP_OPENING_AT=2026-10-16

# 若用易联云：
# CLOUD_PRINT_PROVIDER=yilianyun
# YLY_CLIENT_ID=
# YLY_CLIENT_SECRET=
# YLY_MACHINE_CODE=
