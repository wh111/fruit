.page {
  padding-bottom: 200rpx;
}

.tip-card {
  background: linear-gradient(135deg, #fff8e7 0%, #e8f5e9 100%);
}

.tip-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2a2a2a;
}

.tip-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.label {
  font-weight: 700;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0ebe3;
}

.yen {
  font-size: 48rpx;
  font-weight: 800;
  color: #e8910f;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 800;
  color: #2a2a2a;
  height: 80rpx;
}

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.remark {
  background: #f7f4ee;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  font-size: 28rpx;
}

.coupon-hint {
  margin: -4rpx 0 16rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  line-height: 1.45;
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #f7f4ee;
  border: 2rpx solid transparent;
}

.coupon-row.on {
  background: #fff8e7;
  border-color: #f5a623;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2a2a2a;
}

.coupon-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.coupon-check {
  width: 40rpx;
  text-align: center;
  color: #e8910f;
  font-weight: 800;
  font-size: 28rpx;
}

.modes {
  display: flex;
  gap: 16rpx;
}

.mode {
  flex: 1;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: #f7f4ee;
  border: 2rpx solid transparent;
}

.mode.on {
  background: #fff8e7;
  border-color: #f5a623;
}

.mode-name {
  font-weight: 700;
  font-size: 28rpx;
}

.mode-desc {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.4;
}

.recharge-link {
  margin-top: 16rpx;
  color: #e65100;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pay-sum {
  flex: 1;
}

.pay-sum .muted {
  display: block;
  font-size: 22rpx;
  color: #8a8a8a;
}

.pay-sum .sum {
  font-size: 40rpx;
  font-weight: 800;
  color: #e8910f;
}

.pay-bar .pay {
  flex: 1.2;
  margin: 0;
}

.phone-pay {
  font-size: 26rpx;
}
