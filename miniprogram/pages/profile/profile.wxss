.head { display: flex; gap: 24rpx; align-items: center; }
.logo { width: 120rpx; height: 120rpx; border-radius: 24rpx; background: #fff; }
.brand { font-size: 36rpx; font-weight: 800; }
.phone-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4caf50;
}
.menu .row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0ebe3;
  font-size: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu .row:last-child { border-bottom: none; }
.phone-btn {
  width: 100% !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  text-align: left !important;
  line-height: inherit !important;
  font-size: 30rpx !important;
  color: #e8910f !important;
  font-weight: 600;
  padding-left: 0 !important;
  padding-right: 0 !important;
}
.phone-btn::after { border: none; }
.badge {
  font-size: 22rpx;
  color: #e8910f;
  background: #fff3e0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.title { font-weight: 700; margin-bottom: 12rpx; }
