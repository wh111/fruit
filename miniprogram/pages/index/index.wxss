.page { padding-bottom: 40rpx; }

.hero {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff8e7 0%, #e8f5e9 100%);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.hero-logo { width: 120rpx; height: 120rpx; background: #fff; border-radius: 24rpx; }
.brand { display: block; font-size: 40rpx; font-weight: 800; color: #2a2a2a; }
.slogan { display: block; margin-top: 8rpx; color: #2e7d32; font-size: 28rpx; font-weight: 700; }
.slogan-sub { display: block; margin-top: 6rpx; color: #4caf50; font-size: 22rpx; }

.fresh-pledge {
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 2rpx solid #c8e6c9;
  border-radius: 16rpx;
  color: #33691e;
  font-size: 22rpx;
  line-height: 1.5;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}
.fresh-dot { color: #4caf50; font-size: 16rpx; line-height: 1.8; flex-shrink: 0; }

.promo {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  background: #e8f5e9;
  color: #2e7d32;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.banner {
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #2e7d32 0%, #43a047 48%, #f5a623 100%);
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(46, 125, 50, 0.22);
}
.banner-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  margin-bottom: 10rpx;
}
.banner-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}
.banner-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}
.banner-right {
  flex-shrink: 0;
  text-align: center;
}
.banner-btn {
  background: #fff;
  color: #2e7d32;
  font-weight: 700;
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
}
.banner-count {
  margin-top: 10rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.err {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  background: #fdecea;
  color: #c62828;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.debug {
  margin: 0 24rpx 12rpx;
  color: #b0b0b0;
  font-size: 20rpx;
}

.cats {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
  height: 88rpx;
  box-sizing: border-box;
}
.cat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  vertical-align: middle;
  flex-shrink: 0;
}
.cat.on {
  background: #f5a623;
  color: #fff;
  font-weight: 600;
}
.cat-text {
  line-height: 1.2;
  display: block;
}

.item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx !important;
}
.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #f0ebe3;
  flex-shrink: 0;
}
.info { flex: 1; display: flex; flex-direction: column; }
.name { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.row { margin-top: auto; display: flex; align-items: baseline; gap: 6rpx; }
.preorder {
  margin-left: 8rpx;
  color: #4caf50;
  font-size: 22rpx;
  font-weight: 700;
}
.buy {
  margin-left: auto;
  background: #4caf50;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}
.empty { text-align: center; padding: 80rpx; }

.phone-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 16, 10, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.phone-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.phone-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}
.phone-desc {
  color: #7a7a7a;
  font-size: 26rpx;
  line-height: 1.55;
  margin-bottom: 28rpx;
}
.phone-auth-btn {
  width: 100%;
  margin: 0;
  border: none;
  line-height: 1.2;
}
.phone-auth-btn::after { border: none; }
.phone-skip {
  text-align: center;
  color: #9a9a9a;
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 12rpx;
}
