<view class="page">
  <view class="card head">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <view>
      <view class="brand">四季果先</view>
      <view class="muted">SEASONAL FRUIT · 现切现做 · 新鲜40分钟</view>
      <view class="muted" style="margin-top:8rpx">{{user.nickName || '果粉'}}</view>
      <view class="phone-line" wx:if="{{user.hasPhone}}">手机 {{user.phoneMasked}}</view>
    </view>
  </view>

  <view class="card menu">
    <view class="row" bindtap="goWallet">
      <text>储值余额</text>
      <text class="badge" wx:if="{{balance > 0}}">¥{{balance}}</text>
      <text class="muted" wx:else>充值有礼</text>
    </view>
    <view class="row" bindtap="goActivities">
      <text>活动中心</text>
      <text class="muted">福利与往期</text>
    </view>
    <view class="row" bindtap="goCoupons">
      <text>我的优惠券</text>
      <text class="badge" wx:if="{{couponUnused}}">{{couponUnused}} 张可用</text>
    </view>
    <view class="row" bindtap="goGroupBuy">企业团购</view>
    <view class="row" bindtap="goOrders">我的订单</view>
    <button
      wx:if="{{!user.hasPhone}}"
      class="row phone-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhone"
    >手机号快捷登录</button>
    <view class="row" wx:else>
      <text>手机号</text>
      <text class="muted">{{user.phoneMasked}}</text>
    </view>
    <view class="row" bindtap="reLogin">重新登录</view>
  </view>

  <view class="card tip">
    <view class="title">取餐说明</view>
    <view class="muted">支付成功后会生成取餐号。我们按取餐时间现切，保证取餐前最多40分钟制作完成；到柜台报号，店员对一下即可。</view>
    <view class="muted" style="margin-top:12rpx">登录手机号后，同一号码的优惠券会保持一致。</view>
  </view>
</view>
