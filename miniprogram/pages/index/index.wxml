<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/images/logo.png" mode="aspectFit" />
    <view class="hero-text">
      <text class="brand">四季果先</text>
      <text class="slogan">现切现做 · 新鲜40分钟</text>
      <text class="slogan-sub">提前订 · 到点取 · 一份也做</text>
    </view>
  </view>

  <view class="member-card">
    <view class="member-card-top">
      <view class="member-card-title">{{memberCardTitle}}</view>
      <view class="member-card-chip" wx:if="{{isMember}}">已开通</view>
    </view>
    <view class="member-card-sub">{{memberCardSub}}</view>
    <view class="member-perk" wx:for="{{memberPerks}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="wallet-entry" wx:if="{{walletEnabled}}" bindtap="goWallet">
    <view class="wallet-left">
      <view class="wallet-title">会员充值</view>
      <view class="wallet-sub">{{walletHint || '充值有礼 · 余额整单付 · 开通会员权益'}}</view>
    </view>
    <view class="wallet-go">去充值</view>
  </view>

  <view class="bulk-entry" bindtap="goBulk">
    <view class="bulk-left">
      <view class="bulk-title">自定义金额</view>
      <view class="bulk-sub">散装称重自行输入金额付款</view>
    </view>
    <view class="bulk-go">去付款</view>
  </view>

  <view class="err" wx:if="{{loadError}}">{{loadError}}</view>

  <view class="menu">
    <scroll-view scroll-y class="side" enhanced show-scrollbar="{{false}}">
      <view
        class="side-cat {{activeCat === item ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="onCat"
      >
        <view class="side-bar" wx:if="{{activeCat === item}}"></view>
        <text class="side-text">{{item}}</text>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="goods" enhanced show-scrollbar="{{false}}">
      <view class="goods-pad">
        <view
          class="item"
          wx:for="{{filtered}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail"
        >
          <image class="cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" />
          <view class="info">
            <view class="name">{{item.name}}</view>
            <view class="muted desc">{{item.desc}}</view>
            <view class="row">
              <view class="price-wrap">
                <text class="price">¥{{item.minPrice}}</text>
                <text class="price-origin" wx:if="{{item.showStrike}}">¥{{item.originPrice}}</text>
                <text class="muted">起</text>
                <text class="member-tag" wx:if="{{item.priceTag}}">{{item.priceTag}}</text>
              </view>
              <view class="buy">选规格</view>
            </view>
          </view>
        </view>
        <view wx:if="{{!filtered.length}}" class="empty muted">暂无商品，请稍后再来</view>
      </view>
    </scroll-view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount > 0}}">
    <view class="cart-bar-main" bindtap="goCart">
      <view class="cart-badge">{{cartCount}}</view>
      <view>
        <view class="cart-title">购物车</view>
        <view class="cart-sub">
          预估 ¥{{cartEstimate}}
          <text class="cart-origin" wx:if="{{cartShowStrike}}">¥{{cartOriginEstimate}}</text>
        </view>
      </view>
    </view>
    <view class="cart-go" bindtap="goCheckout">去结算</view>
  </view>

  <!-- 开业抽奖：进店弹窗转盘 -->
  <view class="lottery-mask" wx:if="{{showLottery}}" catchtouchmove="true">
    <view class="lottery-sheet">
      <view class="lottery-close" bindtap="skipLottery">×</view>
      <view class="lottery-title">{{lotteryTitle}}</view>
      <view class="lottery-sub">{{lotterySub}}</view>

      <view class="wheel-box" wx:if="{{!lotteryResult}}">
        <view class="wheel-pointer"></view>
        <view
          class="wheel"
          style="background: {{wheelBg}}; transform: rotate({{wheelDeg}}deg); transition: {{wheelTransition}};"
          bindtap="onLotterySpin"
        >
          <view
            class="wheel-label"
            wx:for="{{wheelLabels}}"
            wx:key="id"
            style="transform: rotate({{item.mid}}deg);"
          >
            <text class="wheel-label-text">{{item.short}}</text>
          </view>
          <view class="wheel-hub" catchtap="onLotterySpin">
            <text class="hub-go">{{lotterySpinning ? '…' : '抽'}}</text>
          </view>
        </view>
        <view class="wheel-hint">点击转盘抽奖</view>
      </view>

      <view class="lottery-result" wx:else>
        <view class="result-badge">{{lotteryResult.type === 'none' ? '谢谢参与' : '恭喜中奖'}}</view>
        <view class="result-name">{{lotteryResult.title}}</view>
        <view class="result-desc" wx:if="{{lotteryResult.type !== 'none'}}">
          已发放 {{lotteryResult.qty || 1}} 张，放入「我的优惠券」
        </view>
        <view class="result-desc" wx:else>欢迎到店尝鲜</view>
        <button class="btn-primary result-btn" wx:if="{{lotteryResult.type !== 'none'}}" bindtap="goLotteryCoupons">去看优惠券</button>
        <button class="btn-primary result-btn" wx:elif="{{lotteryCanAgain}}" bindtap="lotteryAgain">再抽一次</button>
        <view class="lottery-skip" bindtap="closeLottery">先去点单</view>
      </view>
    </view>
  </view>

  <!-- 天天领券弹框：每天二选一 -->
  <view class="promo-mask" wx:if="{{showPromoPop}}" catchtouchmove="true">
    <view class="promo-sheet">
      <view class="promo-close" bindtap="closePromoPop">×</view>
      <view class="promo-pop-title">今日活动券</view>
      <view class="promo-pop-hint">{{promoPopHint}}</view>
      <view
        class="promo-pop-item theme-{{item.theme}} {{item.claimed ? 'claimed' : ''}} {{item.locked ? 'locked' : ''}}"
        wx:for="{{promoPopItems}}"
        wx:key="pack"
      >
        <view class="promo-pop-main">
          <view class="promo-pop-tag">{{item.tag}}</view>
          <view class="promo-pop-name">{{item.title}}</view>
          <view class="promo-pop-sub">{{item.sub}}</view>
          <view class="promo-pop-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
          <view class="promo-pop-status" wx:if="{{item.claimed}}">领取过</view>
          <view class="promo-pop-status muted" wx:elif="{{item.locked}}">今日已选其他</view>
        </view>
        <view
          class="promo-pop-btn {{item.claimed ? 'order' : ''}}"
          wx:if="{{item.claimed}}"
          data-pack="{{item.pack}}"
          bindtap="onPromoGoOrder"
        >去下单</view>
        <view
          class="promo-pop-btn"
          wx:elif="{{!item.locked}}"
          data-pack="{{item.pack}}"
          bindtap="onClaimPromo"
        >{{promoClaimingPack === item.pack ? '领取中…' : '立即领取'}}</view>
        <view class="promo-pop-btn disabled" wx:else>不可领</view>
      </view>
      <view class="promo-pop-skip" bindtap="closePromoPop">先去点单</view>
    </view>
  </view>

  <!-- 仅用户主动点击后再出现，不在进店时强制弹出 -->
  <view class="phone-mask" wx:if="{{showPhoneAuth && !showLottery && !showPromoPop}}" catchtouchmove="true">
    <view class="phone-sheet">
      <view class="phone-title">手机号快捷登录</view>
      <view class="phone-desc">用于同步优惠券，换机后也能继续用同一份福利。</view>
      <button
        class="btn-primary phone-auth-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >手机号快捷登录</button>
      <view class="phone-skip" bindtap="skipPhoneAuth">稍后再说</view>
    </view>
  </view>
</view>
