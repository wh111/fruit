<view class="page" wx:if="{{product}}">
  <image class="banner" src="{{coverUrl}}" mode="aspectFill" />
  <view class="card main">
    <view class="name">{{product.name}}</view>
    <view class="muted">{{product.desc}}</view>
    <view class="price-row">
      <text class="price">¥{{unitPrice}}</text>
      <text class="price-origin" wx:if="{{showStrike}}">¥{{originUnitPrice}}</text>
      <text class="price-tag" wx:if="{{priceTag}}">{{priceTag}}</text>
    </view>
    <view class="price-tip muted" wx:if="{{priceTip}}">{{priceTip}}已计入上方价格</view>
  </view>

  <view class="card" wx:if="{{isRetail}}">
    <view class="muted">成品现取，不参与预定。</view>
  </view>

  <view class="card promo-card" wx:elif="{{loyaltyHint}}">
    <view class="promo-title">会员优惠</view>
    <view class="promo-line">{{loyaltyHint}}</view>
  </view>

  <view class="card">
    <view class="section-title">规格</view>
    <view class="chips">
      <view
        class="chip {{specId === item.id ? 'on' : ''}}"
        wx:for="{{specViews}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSpec"
      >
        <text>{{item.name}}</text>
        <text class="chip-price">¥{{item.displayPrice}}</text>
        <text class="chip-origin" wx:if="{{item.showStrike}}">¥{{item.originPrice}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{extraPick > 0}}">
    <view class="section-title">自选水果（必选 {{extraPick}} 种）</view>
    <view class="muted" style="margin-bottom:16rpx">已选 {{extras.length}}/{{extraPick}}</view>
    <view class="chips">
      <view
        class="chip {{extraMap[item.id] ? 'on' : ''}}"
        wx:for="{{product.extras}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onExtra"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card" wx:elif="{{product.extras && product.extras.length}}">
    <view class="section-title">加料（可多选）</view>
    <view class="chips">
      <view
        class="chip {{extraMap[item.id] ? 'on' : ''}}"
        wx:for="{{product.extras}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onExtra"
      >{{item.name}} +¥{{item.price}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{isFruitBowl && toppings.length}}">
    <view class="section-title">小料（可多选，默认不加）</view>
    <view class="chips">
      <view
        class="chip {{toppingMap[item.id] ? 'on' : ''}}"
        wx:for="{{toppings}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTopping"
      >{{item.name}} <text wx:if="{{item.price > 0}}">+¥{{item.price}}</text><text wx:else>免费</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">数量</view>
    <view class="qty">
      <view class="qbtn" bindtap="dec">-</view>
      <text>{{quantity}}</text>
      <view class="qbtn" bindtap="inc">+</view>
    </view>
  </view>

  <view class="footer dual">
    <view class="total">
      <view class="muted" style="font-size:22rpx">{{priceTag || '单价'}}</view>
      <view class="price-row compact">
        <text class="price">¥{{unitPrice}}</text>
        <text class="price-origin" wx:if="{{showStrike}}">¥{{originUnitPrice}}</text>
      </view>
    </view>
    <view class="btn-ghost" bindtap="addCart">加入购物车</view>
    <view class="btn-primary pay" bindtap="buyNow">立即购买</view>
  </view>
</view>
