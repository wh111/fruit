.page { padding-bottom: 48rpx; }

.hero {
  background: linear-gradient(135deg, #e8f5e9, #fff8e7);
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2e7d32;
  background: rgba(76, 175, 80, 0.12);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 800;
}
.sub {
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.55;
}

.section {
  font-weight: 700;
  margin-bottom: 16rpx;
}
.point {
  color: #555;
  font-size: 26rpx;
  line-height: 1.7;
}

.contact .name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}
.phone {
  font-size: 40rpx;
  font-weight: 800;
  color: #e8910f;
  letter-spacing: 2rpx;
}
.call {
  margin: 24rpx;
}
