<view class="page">
  <view class="hero card" wx:if="{{campaign}}">
    <view class="hero-title">{{campaign.title}} <text class="expired-tag" wx:if="{{campaign.status === 'expired'}}">已过期</text></view>
    <view class="hero-sub">{{campaign.status === 'expired' ? '本活动已结束，不再发放新人礼' : campaign.subtitle}}</view>
    <view class="hero-monthly" wx:if="{{campaign.monthlyGift && campaign.status !== 'expired'}}">甜蜜迎周末：{{campaign.monthlyGift.desc}}</view>
    <view class="stats">
      <view class="stat">
        <text class="num">{{summary.unused || 0}}</text>
        <text class="label">可用</text>
      </view>
      <view class="stat">
        <text class="num">{{summary.flat1 || summary.flat2 || 0}}</text>
        <text class="label">会员日减1</text>
      </view>
      <view class="stat">
        <text class="num">{{summary.reserve3 || 0}}</text>
        <text class="label">预定立减</text>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'unused' ? 'on' : ''}}" data-tab="unused" bindtap="onTab">未使用</view>
    <view class="tab {{tab === 'used' ? 'on' : ''}}" data-tab="used" bindtap="onTab">已使用</view>
    <view class="tab {{tab === 'expired' ? 'on' : ''}}" data-tab="expired" bindtap="onTab">已过期</view>
  </view>

  <view class="coupon" wx:for="{{shown}}" wx:key="id">
    <view class="left">
      <view class="amount" wx:if="{{item.type === 'percent' || item.type === 'free_item'}}">{{item.amountText}}</view>
      <view class="amount" wx:else><text class="yen">¥</text>{{item.amount}}</view>
      <view class="cond">{{item.usableHint}}</view>
    </view>
    <view class="right">
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.fulfillment === 'reserve' ? '仅提前预定可用' : '现取 / 预定均可'}}</view>
      <view class="muted">有效期至 {{item.expireText}}</view>
      <view class="badge">{{item.statusText}}</view>
    </view>
  </view>

  <view class="empty muted" wx:if="{{!shown.length}}">暂无优惠券</view>

  <view class="card rules" wx:if="{{rules.length}}">
    <view class="rules-title">使用说明</view>
    <view class="rule" wx:for="{{rules}}" wx:key="*this">· {{item}}</view>
  </view>

  <view class="btn-primary use" bindtap="goHome">去下单</view>
</view>
