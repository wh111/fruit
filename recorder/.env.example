API_BASE=http://127.0.0.1:3000
ADMIN_USER=admin
ADMIN_PASS=admin123

# TP-Link ONVIF 摄像头 RTSP 地址（按说明书修改路径）
# 示例：rtsp://admin:密码@192.168.1.20:554/stream1
RTSP_URL=rtsp://admin:你的密码@192.168.1.20:554/stream1

POLL_MS=2000
# 裁剪片头/片尾秒数（去掉点按钮前后晃动）
TRIM_HEAD_SEC=1
TRIM_TAIL_SEC=1

# WORK_DIR=./tmp
# FFMPEG_PATH=ffmpeg
