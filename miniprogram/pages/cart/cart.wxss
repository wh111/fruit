.page { padding: 24rpx 24rpx 180rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f0ebe3;
  flex-shrink: 0;
}
.info { flex: 1; min-width: 0; }
.name { font-weight: 700; font-size: 30rpx; margin-bottom: 8rpx; }
.bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.qty { display: flex; align-items: center; gap: 20rpx; }
.qbtn {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #f5f1ea; text-align: center; line-height: 48rpx; font-size: 28rpx;
}
.del { color: #999; font-size: 24rpx; padding: 8rpx; flex-shrink: 0; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 24rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,.06);
}
.total { flex: 1; }
.pay { flex: 0 0 240rpx; text-align: center; }
.price-wrap {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
}
.price-origin {
  color: #9a9a9a;
  font-size: 22rpx;
  text-decoration: line-through;
  font-weight: 400;
}
.price-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff3df;
  color: #c47a12;
  font-size: 20rpx;
  font-weight: 700;
}
.est-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}
