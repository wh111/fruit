.banner {
  width: 100%;
  height: 420rpx;
  background: #f0ebe3;
}
.main .name { font-size: 40rpx; font-weight: 800; margin-bottom: 8rpx; }
.main .price { margin-top: 16rpx; font-size: 40rpx; }

.section-title { font-weight: 700; margin-bottom: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f1ea;
  color: #555;
  font-size: 26rpx;
}
.chip.on {
  background: #fff3e0;
  color: #e8910f;
  outline: 2rpx solid #f5a623;
  font-weight: 600;
}

.qty { display: flex; align-items: center; gap: 28rpx; }
.qbtn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #f5f1ea; text-align: center; line-height: 56rpx; font-size: 32rpx;
}
.remark {
  background: #f7f4ee;
  border-radius: 12rpx;
  padding: 16rpx;
}

.promo-card {
  background: linear-gradient(135deg, #fff8e7 0%, #e8f5e9 100%);
}
.promo-title { font-weight: 800; margin-bottom: 8rpx; }
.promo-line { color: #3d8b40; font-size: 26rpx; line-height: 1.5; margin-bottom: 8rpx; }

.modes { display: flex; gap: 16rpx; }
.modes.col { flex-direction: column; }
.mode {
  flex: 1;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: #f7f4ee;
  border: 2rpx solid transparent;
}
.mode.on {
  background: #fff8e7;
  border-color: #f5a623;
}
.mode.off { opacity: 0.45; }
.mode-name { font-weight: 700; font-size: 28rpx; }
.mode-desc { margin-top: 8rpx; color: #8a8a8a; font-size: 22rpx; line-height: 1.4; }
.mode .fee { margin-left: 10rpx; font-size: 22rpx; color: #e8910f; font-weight: 600; }
.mode .fee.free { color: #4caf50; }
.chip.sale { color: #c86100; }

.coupon-card { }
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.coupon-value {
  flex: 1;
  text-align: right;
  color: #8a8a8a;
  font-size: 26rpx;
}
.coupon-value.on {
  color: #e8910f;
  font-weight: 700;
}
.coupon-value::after {
  content: ' ›';
  color: #bbb;
  font-weight: 400;
}

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 20rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.04);
}
.total { flex: 1; font-size: 28rpx; }
.save { color: #4caf50; font-size: 22rpx; font-weight: 700; margin-bottom: 4rpx; }
.strike {
  margin-left: 10rpx;
  color: #b0b0b0;
  font-size: 24rpx;
  text-decoration: line-through;
  font-weight: 400;
}
.pay { flex: 1.2; }
.page { padding-bottom: 180rpx; }
