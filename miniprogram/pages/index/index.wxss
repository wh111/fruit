.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: 0;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 999rpx;
  background: #2a2a2a;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.18);
}
.cart-bar-main { flex: 1; display: flex; align-items: center; gap: 16rpx; }
.cart-badge {
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #f5a623;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}
.cart-title { font-size: 28rpx; font-weight: 700; }
.cart-sub { font-size: 22rpx; color: rgba(255,255,255,.72); margin-top: 2rpx; }
.cart-go {
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #f5a623;
  color: #fff;
  font-weight: 800;
  font-size: 28rpx;
}

.hero {
  margin: 12rpx 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff8e7 0%, #e8f5e9 100%);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.hero-logo { width: 72rpx; height: 72rpx; background: #fff; border-radius: 18rpx; }
.brand { display: block; font-size: 32rpx; font-weight: 800; color: #2a2a2a; }
.slogan { display: block; margin-top: 4rpx; color: #2e7d32; font-size: 24rpx; font-weight: 700; }
.slogan-sub { display: block; margin-top: 2rpx; color: #4caf50; font-size: 20rpx; }

.member-card {
  margin: 0 24rpx 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #fffdf8 0%, #eef8ee 55%, #fff6e8 100%);
  border: 2rpx solid rgba(46, 125, 50, 0.12);
}
.member-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.member-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f3d22;
}
.member-card-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(46, 125, 50, 0.14);
  color: #2e7d32;
  font-size: 20rpx;
  font-weight: 700;
}
.member-card-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5f7a5a;
  line-height: 1.45;
}
.member-perk {
  margin-top: 10rpx;
  padding-left: 18rpx;
  position: relative;
  font-size: 22rpx;
  color: #3d523c;
  line-height: 1.45;
}
.member-perk::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #43a047;
}

.wallet-entry {
  margin: 0 24rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #2e7d32, #43a047 55%, #f5a623);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(46, 125, 50, 0.2);
}
.wallet-title {
  font-size: 30rpx;
  font-weight: 800;
}
.wallet-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.92;
}
.wallet-go {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #2e7d32;
  font-size: 24rpx;
  font-weight: 700;
}

.bulk-entry {
  margin: 0 24rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #ffe0b2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.bulk-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2a2a2a;
}
.bulk-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}
.bulk-go {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f5a623, #e8910f);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.promo {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  background: #e8f5e9;
  color: #2e7d32;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.banner {
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #2e7d32 0%, #43a047 48%, #f5a623 100%);
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(46, 125, 50, 0.22);
}
.banner-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  margin-bottom: 10rpx;
}
.banner-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}
.banner-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}
.banner-right {
  flex-shrink: 0;
  text-align: center;
}
.banner-btn {
  background: #fff;
  color: #2e7d32;
  font-weight: 700;
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
}
.banner-count {
  margin-top: 10rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.err {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  background: #fdecea;
  color: #c62828;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.promo-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 24, 18, 0.55);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.promo-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fffaf3;
  position: relative;
}
.promo-close {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: #9a8f80;
}
.promo-pop-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2a2418;
}
.promo-pop-hint {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #7a6e5c;
  line-height: 1.45;
  padding-right: 48rpx;
}
.promo-pop-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
}
.promo-pop-item.theme-warm {
  background: linear-gradient(135deg, #fff8ee, #ffe8c8);
}
.promo-pop-item.theme-winter {
  background: linear-gradient(135deg, #f3faf1, #e0f0e2);
}
.promo-pop-item.claimed,
.promo-pop-item.locked {
  opacity: 0.92;
}
.promo-pop-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #c27800;
}
.promo-pop-item.theme-winter .promo-pop-tag { color: #2e7d32; }
.promo-pop-name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #2a2418;
}
.promo-pop-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a6e5c;
  line-height: 1.4;
}
.promo-pop-detail {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a8f80;
  line-height: 1.4;
}
.promo-pop-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #c27800;
}
.promo-pop-status.muted { color: #9a8f80; }
.promo-pop-btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #2a2418;
  color: #fff8ee;
  font-size: 24rpx;
  font-weight: 700;
}
.promo-pop-btn.order {
  background: linear-gradient(135deg, #43a047, #2e7d32);
}
.promo-pop-btn.disabled {
  background: #d7d0c6;
  color: #fff;
}
.promo-pop-skip {
  margin-top: 8rpx;
  text-align: center;
  color: #9a8f80;
  font-size: 24rpx;
  padding: 16rpx;
}
.menu {
  flex: 1;
  min-height: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #f0ebe3;
}
.side {
  width: 168rpx;
  height: 100%;
  background: #f6f6f6;
  flex-shrink: 0;
}
.side-cat {
  position: relative;
  padding: 28rpx 16rpx 28rpx 20rpx;
  text-align: center;
  color: #666;
  font-size: 24rpx;
  line-height: 1.35;
}
.side-cat.on {
  background: #fff;
  color: #222;
  font-weight: 700;
}
.side-bar {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #f5a623;
}
.side-text { display: block; }
.goods { flex: 1; height: 100%; background: #fff; }
.goods-pad { padding: 8rpx 16rpx calc(150rpx + env(safe-area-inset-bottom)); }
.price-wrap {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
  min-width: 0;
}
.price-origin,
.cart-origin {
  color: #9a9a9a;
  font-size: 22rpx;
  text-decoration: line-through;
  font-weight: 400;
}
.member-tag {
  margin-left: 2rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff3df;
  color: #c47a12;
  font-size: 20rpx;
  font-weight: 700;
}
.desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f3f0ea;
}
.cover {
  width: 148rpx;
  height: 148rpx;
  border-radius: 20rpx;
  background: #f0ebe3;
  flex-shrink: 0;
}
.info { flex: 1; display: flex; flex-direction: column; }
.name { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.row { margin-top: auto; display: flex; align-items: baseline; gap: 6rpx; }
.preorder {
  margin-left: 8rpx;
  color: #4caf50;
  font-size: 22rpx;
  font-weight: 700;
}
.buy {
  margin-left: auto;
  background: #4caf50;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}
.empty { text-align: center; padding: 80rpx; }

.lottery-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 16, 10, 0.62);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.lottery-sheet {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: linear-gradient(165deg, #fff8e7 0%, #ffffff 42%, #e8f5e9 100%);
  border-radius: 32rpx;
  padding: 48rpx 28rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.22);
}
.lottery-close {
  position: absolute;
  right: 18rpx;
  top: 12rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #9a9a9a;
}
.lottery-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2e7d32;
}
.lottery-sub {
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: #7a7a7a;
}
.wheel-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wheel-pointer {
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 36rpx solid #e65100;
  margin-bottom: -8rpx;
  z-index: 3;
  position: relative;
  filter: drop-shadow(0 2rpx 2rpx rgba(0, 0, 0, 0.15));
}
.wheel {
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  position: relative;
  border: 10rpx solid #fff;
  box-shadow: 0 8rpx 28rpx rgba(46, 125, 50, 0.28);
  box-sizing: border-box;
}
.wheel-label {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  transform-origin: center center;
}
.wheel-label-text {
  position: absolute;
  left: -70rpx;
  top: -200rpx;
  width: 140rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  line-height: 1.25;
}
.wheel-hub {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 112rpx;
  height: 112rpx;
  margin: -56rpx 0 0 -56rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffb74d, #e65100);
  border: 8rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(230, 81, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.hub-go {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}
.wheel-hint {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}
.lottery-result {
  padding: 24rpx 12rpx 8rpx;
}
.result-badge {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(230, 81, 0, 0.12);
  color: #e65100;
  font-size: 24rpx;
  font-weight: 700;
}
.result-name {
  margin: 24rpx 0 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #2e7d32;
}
.result-desc {
  font-size: 26rpx;
  color: #7a7a7a;
  margin-bottom: 28rpx;
}
.result-btn {
  width: 100%;
  margin: 0;
}
.result-btn::after { border: none; }
.lottery-skip {
  margin-top: 22rpx;
  color: #9a9a9a;
  font-size: 26rpx;
  padding: 12rpx;
}

.phone-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 16, 10, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.phone-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.phone-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}
.phone-desc {
  color: #7a7a7a;
  font-size: 26rpx;
  line-height: 1.55;
  margin-bottom: 28rpx;
}
.phone-auth-btn {
  width: 100%;
  margin: 0;
  border: none;
  line-height: 1.2;
}
.phone-auth-btn::after { border: none; }
.phone-skip {
  text-align: center;
  color: #9a9a9a;
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 12rpx;
}
