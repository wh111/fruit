<view class="page" wx:if="{{order}}">
  <view class="success card">
    <view class="ok">{{queue.title || statusText}}</view>
    <view class="hint">{{queue.tip || '请向店员出示取餐码'}}</view>

    <!-- 进度条 -->
    <view class="steps" wx:if="{{queue.steps && queue.steps.length}}">
      <view
        class="step {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"
        wx:for="{{queue.steps}}"
        wx:key="key"
      >
        <view class="dot"></view>
        <text class="step-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 排队位次 -->
    <view class="queue-box" wx:if="{{queue.phase === 'reserved'}}">
      <view class="queue-num reserved">
        <text class="big">{{order.pickupAtText}}</text>
      </view>
      <view class="queue-meta muted">店员会在取餐时间前半小时内现切制作，高峰不用现场等</view>
    </view>

    <view class="queue-box" wx:if="{{queue.phase === 'queued' || queue.phase === 'making'}}">
      <view class="queue-num" wx:if="{{queue.phase === 'queued'}}">
        <text class="big">{{queue.position}}</text>
        <text class="unit">位</text>
      </view>
      <view class="queue-num making" wx:else>
        <text class="big">制作中</text>
      </view>
      <view class="queue-meta muted" wx:if="{{queue.phase === 'queued'}}">
        前面还有 {{queue.ahead}} 单 · 今日排队共 {{queue.queueTotal}} 单
      </view>
      <view class="queue-meta muted" wx:else>请耐心等待，做好后会显示「请取餐」</view>
    </view>

    <view class="code">{{order.pickupCode}}</view>
    <image wx:if="{{qrDataUrl}}" class="qr" src="{{qrDataUrl}}" mode="aspectFit" show-menu-by-longpress />
    <view class="muted">长按二维码可保存 · 店员扫码核销</view>

  </view>

  <view class="card">
    <view class="row"><text>商品</text><text>{{order.productName}}</text></view>
    <view class="row"><text>规格</text><text>{{order.specName}} ×{{order.quantity}}</text></view>
    <view class="row" wx:if="{{extraText}}"><text>加料</text><text>{{extraText}}</text></view>
    <view class="row"><text>取餐</text><text>{{order.fulfillmentType === 'reserve' ? (order.pickupAtText || '预约') : '现作现取'}}</text></view>
    <view class="row"><text>送达</text><text>{{order.deliveryPointName || '到店取'}}<text wx:if="{{order.deliveryFee > 0}}"> · 配送费¥{{order.deliveryFee}}</text></text></view>
    <view class="row" wx:if="{{order.discountAmount > 0}}"><text>优惠</text><text>{{order.discountLabel}}</text></view>
    <view class="row" wx:if="{{order.loyaltySave > 0}}"><text>月折</text><text>{{order.loyaltyLabel}} -¥{{order.loyaltySave}}</text></view>
    <view class="row" wx:if="{{order.couponSave > 0}}"><text>立减</text><text>-¥{{order.couponSave}}</text></view>
    <view class="row">
      <text>金额</text>
      <text class="price">¥{{order.amount}}<text class="strike" wx:if="{{order.originalAmount && order.discountAmount > 0}}">¥{{order.originalAmount}}</text></text>
    </view>
    <view class="row"><text>订单号</text><text class="small">{{order.orderNo}}</text></view>
    <view class="row"><text>状态</text><text>{{statusText}}</text></view>
  </view>

  <view class="actions">
    <view class="btn-green" bindtap="goOrders">查看我的订单</view>
    <view class="btn-primary" style="margin-top:20rpx" bindtap="goHome">再点一份</view>
  </view>
</view>
